# Copia este archivo a .env y ajusta valores. Nunca subas secretos reales al repositorio.
DATABASE_URL=postgres://crm:crm_dev@localhost:5432/crm_recluta
TEST_DATABASE_URL=postgres://crm:crm_dev@localhost:5432/crm_recluta_test
PORT=3000
# URL pública del portal (se usa para construir ligas de reclutamiento)
PUBLIC_BASE_URL=http://localhost:5173
# Secreto para HMAC de códigos OTP. Genera uno con: openssl rand -hex 32
OTP_SECRET=cambia-esto-por-un-secreto-largo
# sandbox = no se envía nada; los mensajes quedan como "simulados" en la bandeja.
# Cualquier otro valor requiere configurar un proveedor real (ver docs/PENDIENTES.md).
DELIVERY_MODE=sandbox
# Solo en sandbox y fuera de producción: devuelve el código OTP en la respuesta para pruebas.
EXPOSE_DEV_OTP=true
APP_TIMEZONE=America/Mexico_City
NODE_ENV=development
